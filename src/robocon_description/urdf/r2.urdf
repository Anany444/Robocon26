<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="r2">

  <!-- ================= Parameters ================= -->
  <!-- Dimensions from rulebook (max 800x800mm) -->
  <xacro:property name="base_width" value="0.8"/>
  <xacro:property name="base_length" value="0.8"/>
  <xacro:property name="base_height" value="0.07"/>

  <!-- Wheel dimensions -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="caster_radius" value="0.01"/> <!-- Thinner 1cm radius -->
  <xacro:property name="caster_length" value="0.10"/> <!-- 10cm long peg to bridge gap -->
  <xacro:property name="ground_clearance" value="0.10"/> <!-- Raised back to 10cm -->
  
  <!-- Step climbing mechanism parameter -->
  <xacro:property name="step_height" value="0.2"/>
  
  <!-- Positions -->
  <xacro:property name="wheel_ygap" value="-0.02"/>

  <!-- ================= Inertial macros ================= -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
        izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
        iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
        izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0"
        iyy="${(2/5) * m * (r*r)}" iyz="0.0"
        izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= Base ================= -->
  <link name="base_footprint"/>

  <link name="body_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="20.0" w="${base_width}" h="${base_height}" d="${base_length}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="body_link"/>
    <origin xyz="0 0 ${ground_clearance + base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ================= Caster macro ================= -->
  <!-- Casters are fixed passive cylinders with 0 friction in gazebo -->
  <xacro:macro name="caster" params="prefix x_offset y_reflect">
    <link name="${prefix}_caster">
      <visual>
        <!-- The cylindrical standoff -->
        <origin xyz="0 0 ${caster_radius/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_length - caster_radius}"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <visual>
        <!-- The hemispherical tip (represented as a sphere) -->
        <origin xyz="0 0 ${-caster_length/2 + caster_radius}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${caster_radius/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_length - caster_radius}"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 ${-caster_length/2 + caster_radius}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.01" r="${caster_radius}" h="${caster_length}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="body_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x_offset} ${y_reflect*(base_width/2 - 0.05)} ${(caster_length/2) - (ground_clearance + base_height/2)}" rpy="0 0 0"/>
    </joint>
    
    <gazebo reference="${prefix}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <!-- ================= Main Wheel macro ================= -->
  <!-- Main wheel mounted on a prismatic extrusion -->
  <xacro:macro name="main_wheel" params="prefix x_offset y_reflect">
    <!-- Prismatic joint to move the extrusion down -->
    <!-- Positive movement is down (axis 0 0 -1) -->
    <joint name="${prefix}_extrusion_joint" type="prismatic">
      <parent link="body_link"/>
      <child link="${prefix}_extrusion"/>
      <!-- Origin is precisely set so wheel bottom matches caster bottom when fully retracted -->
      <origin xyz="${x_offset} ${y_reflect*(base_width/2 + wheel_ygap)} ${wheel_radius - (ground_clearance + base_height/2)}" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="0.0" upper="${step_height}" effort="500.0" velocity="2.0"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <!-- The vertical extrusion link -->
    <link name="${prefix}_extrusion">
      <visual>
        <!-- The extrusion sticks UP into the chassis from the wheel center -->
        <!-- Length increased to step_height + 0.10 to prevent air gap at full extension -->
        <origin xyz="0 0 ${(step_height + 0.10)/2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.04 ${step_height + 0.10}"/>
        </geometry>
        <material name="green">
          <color rgba="0 0.8 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${(step_height + 0.10)/2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.04 ${step_height + 0.10}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.2" w="0.04" h="${step_height}" d="0.04"/>
    </link>

    <!-- The continuous drive wheel -->
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_extrusion"/>
      <child link="${prefix}_wheel"/>
      <!-- Wheel is exactly at the bottom of the extrusion (extrusion link's origin) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="200.0" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    
    <gazebo reference="${prefix}_wheel">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <min_depth>0.001</min_depth>
      <max_vel>0.1</max_vel>
    </gazebo>
  </xacro:macro>

  <!-- ================= Placements ================= -->
  <!-- Length is 0.8. 5 wheels spaced equally from 0.4 to -0.4 -> interval 0.2 -->

  <!-- Left Side Casters & Wheels (y_reflect=1) -->
  <xacro:caster prefix="left_front_outer" x_offset="0.35" y_reflect="1"/>
  <xacro:main_wheel prefix="left_front" x_offset="0.25" y_reflect="1"/>
  <xacro:caster prefix="left_front_inner" x_offset="0.15" y_reflect="1"/>
  <xacro:caster prefix="left_back_inner" x_offset="-0.15" y_reflect="1"/>
  <xacro:main_wheel prefix="left_back" x_offset="-0.25" y_reflect="1"/>
  <xacro:caster prefix="left_back_outer" x_offset="-0.35" y_reflect="1"/>

  <!-- Right Side Casters & Wheels (y_reflect=-1) -->
  <xacro:caster prefix="right_front_outer" x_offset="0.35" y_reflect="-1"/>
  <xacro:main_wheel prefix="right_front" x_offset="0.25" y_reflect="-1"/>
  <xacro:caster prefix="right_front_inner" x_offset="0.15" y_reflect="-1"/>
  <xacro:caster prefix="right_back_inner" x_offset="-0.15" y_reflect="-1"/>
  <xacro:main_wheel prefix="right_back" x_offset="-0.25" y_reflect="-1"/>
  <xacro:caster prefix="right_back_outer" x_offset="-0.35" y_reflect="-1"/>


  <!-- ================= Gripper Mechanism ================= -->
  <!-- Vertical Extrusions -->
  <link name="left_vertical_extrusion">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.2" w="0.04" h="0.25" d="0.04"/>
  </link>

  <joint name="left_vertical_joint" type="fixed">
    <parent link="body_link"/>
    <child link="left_vertical_extrusion"/>
    <origin xyz="0.42 0.35 0.0" rpy="0 0 0"/>
  </joint>

  <link name="right_vertical_extrusion">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.25"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.2" w="0.04" h="0.25" d="0.04"/>
  </link>

  <joint name="right_vertical_joint" type="fixed">
    <parent link="body_link"/>
    <child link="right_vertical_extrusion"/>
    <origin xyz="0.42 -0.35 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Left Arm (Pitching) -->
  <link name="left_arm">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.04 0.04"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.04 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.3" w="0.04" h="0.04" d="0.4"/>
  </link>

  <joint name="left_arm_joint" type="revolute">
    <parent link="left_vertical_extrusion"/>
    <child link="left_arm"/>
    <origin xyz="0 0 0.25" rpy="0 -1.570796 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="100.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Left Gripping Link (Prismatic inward) -->
  <link name="left_gripper_pad">
    <visual>
      <origin xyz="0 -0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.04 0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.04 0.1"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" w="0.04" h="0.1" d="0.2"/>
  </link>

  <joint name="left_gripper_joint" type="prismatic">
    <parent link="left_arm"/>
    <child link="left_gripper_pad"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.20" effort="100.0" velocity="0.5"/>
  </joint>
  
  <gazebo reference="left_gripper_pad">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <!-- Right Arm (Pitching) -->
  <link name="right_arm">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.04 0.04"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.04 0.04"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.3" w="0.04" h="0.04" d="0.4"/>
  </link>

  <joint name="right_arm_joint" type="revolute">
    <parent link="right_vertical_extrusion"/>
    <child link="right_arm"/>
    <origin xyz="0 0 0.25" rpy="0 -1.570796 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="100.0" velocity="1.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Right Gripping Link (Prismatic inward) -->
  <link name="right_gripper_pad">
    <visual>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.04 0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.04 0.1"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" w="0.04" h="0.1" d="0.2"/>
  </link>

  <joint name="right_gripper_joint" type="prismatic">
    <parent link="right_arm"/>
    <child link="right_gripper_pad"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.20" effort="100.0" velocity="0.5"/>
  </joint>
  
  <gazebo reference="right_gripper_pad">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>


  <!-- Unitree 4D LiDAR L2 -->
  <joint name="unitree_lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="unitree_lidar_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <link name="unitree_lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <xacro:cylinder_inertia m="0.2" r="0.03" h="0.05"/>
  </link>

  <!-- <gazebo reference="unitree_lidar_link">
    <sensor name="unitree_l2" type="gpu_lidar">
      <gz_frame_id>unitree_lidar_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2618</min_angle>
            <max_angle>0.2618</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo> -->

  <!-- Intel RealSense D435f RGBD Camera -->
  <joint name="realsense_camera_joint" type="fixed">
    <parent link="body_link"/>
    <child link="realsense_camera_link"/>
    <!-- Positioned high, floating above chassis, pitched down 15 degrees -->
    <origin xyz="0.1 0 0.45" rpy="0 0.2618 0"/>
  </joint>

  <link name="realsense_camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <xacro:box_inertia m="0.1" w="0.09" h="0.025" d="0.025"/>
  </link>

  <!-- Optical frame for ROS conventions -->
  <joint name="realsense_optical_joint" type="fixed">
    <parent link="realsense_camera_link"/>
    <child link="realsense_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <link name="realsense_optical_frame"/>

  <gazebo reference="realsense_camera_link">
    <sensor name="d435f" type="rgbd_camera">
      <gz_frame_id>realsense_optical_frame</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/rgbd</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.6</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- IMU Sensor -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="body_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- ================= ROS2 Control ================= -->
  <ros2_control name="r2" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Wheels -->
    <joint name="left_front_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_front_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_back_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_back_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Extrusions (Front Pair) -->
    <joint name="left_front_extrusion_joint">
      <param name="p">10000.0</param>
      <param name="i">0.0</param>
      <param name="d">100.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="right_front_extrusion_joint">
      <param name="p">10000.0</param>
      <param name="i">0.0</param>
      <param name="d">100.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Extrusions (Back Pair) -->
    <joint name="left_back_extrusion_joint">
      <param name="p">10000.0</param>
      <param name="i">0.0</param>
      <param name="d">100.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    
    <joint name="right_back_extrusion_joint">
      <param name="p">10000.0</param>
      <param name="i">0.0</param>
      <param name="d">100.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- Arm Joints -->
    <joint name="left_arm_joint">
      <param name="p">1000.0</param>
      <param name="i">0.0</param>
      <param name="d">10.0</param>
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_arm_joint">
      <param name="p">1000.0</param>
      <param name="i">0.0</param>
      <param name="d">10.0</param>
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!-- Gripper Joints -->
    <joint name="left_gripper_joint">
      <param name="p">1000.0</param>
      <param name="i">0.0</param>
      <param name="d">10.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.20</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_gripper_joint">
      <param name="p">1000.0</param>
      <param name="i">0.0</param>
      <param name="d">10.0</param>
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.20</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robocon_bringup)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================ Odometry publisher ============ -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth_odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <!-- <xyz_offset>-2.6165 4.0 0</xyz_offset> -->
      <!-- <rpy_offset>0 0 0</rpy_offset> -->
    </plugin>
  </gazebo>

  <!-- ================ Perfect Holonomic Simulation Overlay ============ -->
  <!-- Since ODE physics cannot simulate mecanum rollers on basic cylinder/sphere meshes, 
       we let ros2_control spin the frictionless wheels visually, while this plugin 
       applies the actual command velocities flawlessly to the robot base. -->
  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
  </gazebo>

</robot>